# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# New FireworkVideo versions are published to the Firework specs repository since CocoaPods trunk became read-only.
# Keep the CDN: React Native's pods and older FireworkVideo versions are only available there.
source 'https://github.com/loopsocial/firework_ios_specs.git'
source 'https://cdn.cocoapods.org/'

platform :ios, min_ios_version_supported
prepare_react_native_project!

use_frameworks! :linkage => :static

target 'FireworkSdkExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :new_arch_enabled => true
  )
  pod 'LookinServer', :configurations => ['Debug']
  pod 'FireworkVideoIVSSupport', '0.9.9'

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
    end
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Raise pods below React Native's minimum, such as the RNCAsyncStorage resource bundle at 13.4, which Xcode 27
        # no longer builds.
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < min_ios_version_supported.to_f
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
        # fmt 11.0.2, bundled with React Native 0.78, fails consteval checks in its own format-inl.h with the clang
        # of Xcode 27. C++17 turns those checks off for this target.
        if target.name == 'fmt'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end
